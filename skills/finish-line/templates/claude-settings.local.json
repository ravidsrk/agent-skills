{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "Task",
      "Skill",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)"
    ]
  }
}
